{
  "name": "journal-browser-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:cycles": "madge --circular --extensions ts,tsx --ts-config tsconfig.json app components hooks lib",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "generate": "openapi-typescript ../openapi.json -o lib/api-types.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.20.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.67.0",
    "maplibre-gl": "^6.19.0",
    "mermaid": "^12.2.0",
    "next": "^16.4.6",
    "next-intl": "^4.15.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "madge": "8.0.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5.7",
    "vitest": "^4.1.12"
  },
  "depcheck": {
    "ignores": [
      "react-dom",
      "@biomejs/biome",
      "eslint",
      "eslint-config-next",
      "jsdom",
      "openapi-typescript",
      "typescript",
      "@types/react-dom",
      "tailwindcss",
      "@tailwindcss/postcss"
    ]
  }
}
