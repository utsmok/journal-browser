# Backend
JB_DATABASE_URL=postgresql+asyncpg://journal:journal@localhost:5433/journalbrowser

# Home institution (change these two to run your own instance).
JB_INSTITUTION_NAME=University of Twente
JB_INSTITUTION_ROR=https://ror.org/006hf6230
# Optional: pin the OpenAlex institution id; otherwise resolved from the ROR.
JB_INSTITUTION_OPENALEX_ID=

# OpenAIRE organization id (openorgs____::...) for the product harvest; empty
# keeps the University of Twente default.
JB_OPENAIRE_ORG_ID=

# OpenAlex API key (free tier) - only needed for cursor-paged harvests; single-entity
# lookups stay keyless. aletheca reads ALETHECA_OPENALEX_API_KEY.
OPENALEX_API_KEY=
ALETHECA_OPENALEX_API_KEY=

# Raw landing zone for downloaded files (default: backend/landing).
JB_LANDING_DIR=landing

# Blocked feature scaffolds (leave OFF until explicitly enabled).
JB_ENABLE_JOURNAL_CITATIONS=false
JB_ENABLE_JISC=false
JB_JISC_API_KEY=
