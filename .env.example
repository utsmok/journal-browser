# Backend
JB_DATABASE_URL=postgresql+asyncpg://journal:journal@localhost:5433/journalbrowser


# Publication-year window (inclusive). START shrinks every harvest to match;
# END=0 means open-ended (to now). Initial Twente deployment: 2020/0.
JB_DATA_WINDOW_START=2020
JB_DATA_WINDOW_END=0

# Home institution (change these to run your own instance). On first boot the
# bootstrap service auto-harvests: OpenAlex journals, openaccess.nl + JCT
# deals, OpenAPC, Scimago seeds, your repository via OAI-PMH, and stats.
JB_INSTITUTION_NAME=University of Twente
JB_INSTITUTION_ROR=https://ror.org/006hf6230

# Institutional repository OAI-PMH endpoint (Twente Pure; anonymous).
JB_PURE_OAI_BASE_URL=https://ris.utwente.nl/ws/oai

# OpenAlex API key (free tier) - only needed for cursor-paged harvests; single
# entity lookups stay keyless. aletheca also reads ALETHECA_OPENALEX_API_KEY.
OPENALEX_API_KEY=

# ut-metadata Postgres (canonical Twente publications, read-only; port 5434 in
# compose). Optional: unset, the ut-works endpoints degrade to
# works_stats-only. A fresh deployment does not need it.
JB_UT_METADATA_DSN=

# OpenAIRE organization id (openorgs____::...) for the product harvest; empty
# = the OpenAIRE harvest is off. Find yours at
# api.openaire.eu/graph/v1/organizations?legalName=<institution name>.
JB_OPENAIRE_ORG_ID=

# Admin panel password (http://<host>/admin); empty = the panel is disabled.
JB_ADMIN_PASSWORD=

# Contact email sent to OpenAlex (polite-pool identification).
JB_CONTACT_EMAIL=

# Bootstrap service mode: auto (only on an empty DB), always, off.
JB_BOOTSTRAP=auto

# Raw landing zone for downloaded files (default: backend/landing).
JB_LANDING_DIR=landing

# Blocked feature scaffolds (leave OFF until explicitly enabled).
JB_ENABLE_JOURNAL_CITATIONS=false
JB_ENABLE_JISC=false
JB_JISC_API_KEY=
